*.egg
MANIFEST
.venv
venv/
ENV/
env/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Node / React ---
node_modules/
dist/
.cache/
*.local

# --- Docker ---
*.log

