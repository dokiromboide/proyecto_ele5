# ============================================================
# PROYECTO_ELE5 - Sistema de Asistencia Unimayor
# ============================================================

# --- Aplicación ---
APP_NAME="Sistema de Asistencia Unimayor"
APP_ENV=development
APP_DEBUG=true
SECRET_KEY=your-secret-key-change-in-production-min-32-chars

# --- Base de Datos PostgreSQL ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=unimayor_asistencia
POSTGRES_USER=unimayor_user
POSTGRES_PASSWORD=your-password-here

DATABASE_URL=postgresql://unimayor_user:your-password-here@db:5432/unimayor_asistencia

# --- JWT Autenticación ---
JWT_SECRET_KEY=jwt-secret-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Backend FastAPI ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://frontend:3000"]

# --- Frontend React ---
VITE_API_URL=http://localhost:8000
VITE_APP_NAME="Sistema de Asistencia Unimayor"

# --- Jira / Atlassian (para agentes IA) ---
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=your-jira-email@example.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=ELE5

# --- Reportes ---
REPORTS_DIR=/app/reports
MAX_REPORT_SIZE_MB=50
